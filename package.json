{
    "name": "script-seance",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.28.2",
    "scripts": {
        "server": "node server/index.js",
        "dev": "vite",
        "start": "concurrently -k -n server,client -c green,cyan \"pnpm run server\" \"pnpm run dev\"",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint . --ext .js,.ts,.tsx",
        "lint:fix": "pnpm run lint -- --fix",
        "docs:typedoc": "typedoc --options typedoc.json",
        "docs:typedoc:watch": "typedoc --options typedoc.json --watch",
        "docs:serve": "pnpm dlx serve docs/typedoc",
        "docs:graph:mermaid": "mkdir -p docs && pnpm exec depcruise --no-config --include-only \"^(components|hooks|services|server|tests|App\\.tsx|index\\.tsx|types\\.ts)\" . --output-type mermaid > docs/dependency-graph.mmd",
        "docs:graph:svg": "bash -lc 'CHROME=\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"; if [ -x \"$CHROME\" ]; then PUPPETEER_EXECUTABLE_PATH=\"$CHROME\" pnpm dlx @mermaid-js/mermaid-cli -i docs/dependency-graph.mmd -o docs/dependency-graph.svg; else pnpm dlx @puppeteer/browsers install chrome-headless-shell && pnpm dlx @mermaid-js/mermaid-cli -i docs/dependency-graph.mmd -o docs/dependency-graph.svg; fi'",
        "docs:all": "pnpm docs:refresh",
        "docs:refresh": "pnpm docs:typedoc && pnpm docs:graph:mermaid",
        "hooks:install": "git config core.hooksPath .githooks"
    },
    "dependencies": {
        "@google/genai": "^1.38.0",
        "cookie": "^1.1.1",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "lucide-react": "^0.556.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.19.7",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.23",
        "concurrently": "^9.0.1",
        "dependency-cruiser": "^17.3.7",
        "eslint": "^9.39.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.1.0",
        "jsdom": "^27.4.0",
        "postcss": "^8.5.6",
        "supertest": "^7.2.2",
        "tailwindcss": "^3.4.19",
        "typedoc": "^0.28.16",
        "typescript": "~5.8.3",
        "vite": "^6.4.1",
        "vitest": "^2.1.9"
    }
}
