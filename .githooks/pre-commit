#!/usr/bin/env bash
set -euo pipefail

changed_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$changed_files" ]; then
  exit 0
fi

run_typedoc=0
run_graph=0

while IFS= read -r file; do
  case "$file" in
    App.tsx|index.tsx|types.ts|typedoc.json|tsconfig.json|README.md|components/*|hooks/*|services/*|server/*|shared/*)
      run_typedoc=1
      ;;
  esac

  case "$file" in
    App.tsx|index.tsx|types.ts|components/*|hooks/*|services/*|server/*|shared/*)
      case "$file" in
        *.ts|*.tsx|*.js|*.jsx)
          run_graph=1
          ;;
      esac
      ;;
  esac
done <<< "$changed_files"

if [ "$run_typedoc" -eq 1 ]; then
  pnpm docs:typedoc
fi

if [ "$run_graph" -eq 1 ]; then
  pnpm docs:graph:mermaid
fi
