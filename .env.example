# Server-side only. Do not expose in client bundles.

# OpenAI API key used for all text-generation requests in Script Seance.
SCRIPT_SEANCE_OPENAI_API_KEY=

# OpenAI model for longer creative generations (e.g. full scene generation).
OPENAI_MODEL=gpt-5.4

# OpenAI model for the lowest-cost fast tier (currently title suggestion and legacy simple script-element calls).
OPENAI_FAST_MODEL=gpt-5.4-nano

# OpenAI model for quality-sensitive non-scene generations (plot twists, insert-block generation, rewrites, surprise setups).
OPENAI_BALANCED_MODEL=gpt-5.4-mini

# Prompt cache retention policy for OpenAI requests. Use in-memory for the default GPT-5.4-family aliases;
# 24h currently applies only to older supported OpenAI model families in this codepath.
OPENAI_PROMPT_CACHE_RETENTION=in-memory

# Max output tokens for scene JSON generation.
OPENAI_SCENE_MAX_OUTPUT_TOKENS=2200

# Optional per-length output token overrides for scene generation.
OPENAI_SCENE_MAX_OUTPUT_TOKENS_SHORT=1210
OPENAI_SCENE_MAX_OUTPUT_TOKENS_MEDIUM=2200
OPENAI_SCENE_MAX_OUTPUT_TOKENS_LONG=2970

# Additional scene headroom to help complete final thoughts near token limits.
OPENAI_SCENE_COMPLETION_BUFFER_TOKENS=180

# Safety cap for a single automatic retry when response is incomplete due to max_output_tokens.
OPENAI_MAX_OUTPUT_TOKENS_RETRY_CAP=5000

# Number of retries when incomplete reason is max_output_tokens.
OPENAI_MAX_OUTPUT_TOKENS_RETRY_ATTEMPTS=3

# Inworld TTS API key.
INWORLD_API_KEY=

# Inworld API secret used to mint JWTs server-side.
INWORLD_API_SECRET=

# Inworld workspace id used for custom voice catalog requests.
INWORLD_WORKSPACE_ID=

# Auth mode. Production must use invite_code. dev_shared_password is local/dev only.
AUTH_MODE=dev_shared_password

# Local/dev password fallback. Do not use with NODE_ENV=production.
ADMIN_PASSWORD=

# Postgres connection for invite-only beta users, invites, and email-code challenges.
DATABASE_URL=postgres://user:password@localhost:5432/script_seance

# Redis/Valkey connection for server sessions and rate-limit counters.
REDIS_URL=redis://localhost:6379

# Secret used to hash short-lived email codes before storage.
AUTH_CODE_SECRET=

# Canonical same-origin app URL used in auth email context.
APP_BASE_URL=http://localhost:3000

# Email-code delivery. Use console for local development; production requires smtp.
AUTH_EMAIL_TRANSPORT=console
AUTH_EMAIL_FROM="Script Seance <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Auth policy defaults.
AUTH_SESSION_IDLE_TTL_MS=43200000
AUTH_SESSION_ABSOLUTE_TTL_MS=1209600000
AUTH_CODE_TTL_MS=600000
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_INVITE_TTL_MS=2592000000
AUTH_LOGIN_WINDOW_MS=600000
AUTH_LOGIN_MAX_ATTEMPTS=8

# Optional API server port (defaults to 3001).
PORT=3001

# Environment setting to control cookie security (use "production" for HTTPS-only cookies).
NODE_ENV=development

# Comma-separated allowlist of browser origins allowed to call mutating /api/auth/* and /api/ai/* routes.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trust exactly one upstream proxy for forwarded client IPs (set to 1 behind a trusted reverse proxy).
TRUST_PROXY=0

# AI rate limits: requests per minute and per day per authenticated user.
AI_RPM=30
AI_RPD=500

# Inworld TTS model for speech generation.
TTS_INWORLD_MODEL=inworld-tts-1.5-max

# Optional inworld API base override (defaults to https://api.inworld.ai).
INWORLD_API_BASE=https://api.inworld.ai

# Inworld engine host used when signing JWT auth headers.
INWORLD_ENGINE_HOST=api-engine.inworld.ai

# Voice list cache TTL in milliseconds.
VOICE_CATALOG_CACHE_TTL_MS=300000

# Maximum number of curated English Inworld voices to import.
INWORLD_MAX_ENGLISH_VOICES=8

# Refresh JWT before it expires (milliseconds).
INWORLD_JWT_REFRESH_BUFFER_MS=60000

# Maximum combined prompt size before rejecting with 413.
AI_MAX_PROMPT_CHARS=8000

# Upstream AI request timeout in milliseconds (0 to disable).
AI_UPSTREAM_TIMEOUT_MS=30000

# Upstream timeout override for full scene generation (often slower than short text modes).
AI_UPSTREAM_TIMEOUT_MS_SCENE=90000

# Upstream retry policy (transient failures only: 429, selected 5xx, and network transport errors).
AI_UPSTREAM_RETRY_MAX_RETRIES=2
AI_UPSTREAM_RETRY_BASE_DELAY_MS=250
AI_UPSTREAM_RETRY_MAX_DELAY_MS=4000
AI_UPSTREAM_RETRY_JITTER_MS=150
